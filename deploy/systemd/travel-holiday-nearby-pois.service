[Unit]
Description=Travel — tüm villa yakın mekan ve mesafe yenileme
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/www/vhosts/rezervasyonyap.tr/httpdocs
EnvironmentFile=-/etc/rezervasyonyap/backend.env
Environment=OSM_REQUEST_TIMEOUT_MS=90000
ExecStart=/usr/bin/env node /var/www/vhosts/rezervasyonyap.tr/httpdocs/scripts/refresh-all-holiday-home-nearby-pois.mjs
TimeoutStartSec=4h
Nice=15
IOSchedulingClass=idle
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
