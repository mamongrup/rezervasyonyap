[Unit]
Description=TCMB Günlük Döviz Kurlarını Otomatik Güncelleme
After=network.target postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/vhosts/rezervasyonyap.tr/httpdocs
Environment=APP_ROOT=/var/www/vhosts/rezervasyonyap.tr/httpdocs
ExecStart=/bin/bash /var/www/vhosts/rezervasyonyap.tr/httpdocs/deploy/scripts/run-currency-rates-sync.sh
StandardOutput=journal
StandardError=journal
