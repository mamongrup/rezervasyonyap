[Unit]
Description=TCMB Günlük Döviz Kurlarını Otomatik Güncelleme
After=network.target postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/vhosts/rezervasyonyap.tr/httpdocs
ExecStart=/usr/bin/node /var/www/vhosts/rezervasyonyap.tr/httpdocs/scripts/sync-tcmb-currency-rates.mjs
StandardOutput=journal
StandardError=journal
