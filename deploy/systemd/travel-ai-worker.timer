# travel-ai-worker.service ile birlikte kullanın (bkz. travel-ai-worker.service başlığı).
# Sürekli içerik üretimi: 3 dk. I/O baskısı olursa OnUnitActiveSec=5min deneyin.

[Unit]
Description=Travel AI worker zamanlayıcısı

[Timer]
OnBootSec=2min
OnUnitActiveSec=3min
AccuracySec=30s
RandomizedDelaySec=20s
Unit=travel-ai-worker.service

[Install]
WantedBy=timers.target
